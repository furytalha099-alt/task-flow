# --- Application Environment ---
# Allowed values: development | test | production
ENVIRONMENT=development

# --- Database (Neon PostgreSQL) ---
# database.py converts postgresql:// to postgresql+psycopg:// and enforces sslmode=require
DATABASE_URL=postgresql+psycopg://username:password@ep-example-pooler.region.aws.neon.tech/taskflow?sslmode=require

# --- Security & JWT Sessions ---
# Must be at least 32 characters (use: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace-with-at-least-32-character-random-secret-key
# Required in production (at least 32 characters) for X-Platform-Admin-Key routes
PLATFORM_MASTER_KEY=replace-with-at-least-32-character-platform-master-key

# --- Token Lifetimes & Cookie Policy ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS (Comma-separated frontend origins; required in production) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate Limiting (Required in production; optional in development/test) ---
REDIS_URL=

# --- Email Notifications (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password

# --- Google OAuth (/auth/google) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com