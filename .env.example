# Replace these placeholders in your private .env file.
# Use separate, random values for both keys.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
PLATFORM_MASTER_KEY=replace-with-a-different-random-secret

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set this to the exact frontend address during local development.
ALLOWED_ORIGINS=http://localhost:3000

# Leave blank for local development if your app allows it.
# Use your Redis connection string if your app is configured to use Redis.
REDIS_URL=